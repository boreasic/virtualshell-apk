# Maintainer: Marcos Romero Lamas <marromlam@gmail.com>
pkgname=codex
pkgver=0.167.0
pkgrel=1
pkgdesc="OpenAI Codex CLI installer (downloads the upstream aarch64 musl package)"
url="https://github.com/openai/codex"
arch="aarch64"
license="MIT"
depends="ca-certificates curl gzip tar git ripgrep procps-ng"
options="!check"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.pre-deinstall"
source="codex-install codex-command LICENSE"

package() {
	install -Dm755 "$srcdir/codex-install" "$pkgdir/usr/sbin/codex-install"
	install -Dm755 "$srcdir/codex-command" "$pkgdir/usr/bin/codex"
	install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/codex/LICENSE"
}

