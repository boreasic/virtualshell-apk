#!/bin/sh
# SPDX-License-Identifier: MIT
# Downloads remain upstream; the small APK contains only this installer.
set -eu
version=0.167.0
sha256=0de261ecf1e7f3028a7952f03fca2093f749277d38590b78bb32f8567756bbb7
url=https://github.com/openai/codex/releases/download/rust-v$version/codex-package-aarch64-unknown-linux-musl.tar.gz
root=/opt/codex
package=$root/$version

[ "$#" -eq 0 ] || { echo 'Usage: codex-install' >&2; exit 2; }
[ "$(id -u)" = 0 ] || { echo 'Run codex-install as root.' >&2; exit 1; }
[ "$(uname -m)" = aarch64 ] || { echo 'Codex requires aarch64.' >&2; exit 1; }
# A single executable supports --version but cannot start the shared daemon.
# Check the full layout so upgrading the old same-version installer repairs it.
complete=true
[ -f "$package/codex-package.json" ] || complete=false
for executable in bin/codex bin/codex-code-mode-host bin/codex-exec-server codex-path/rg codex-resources/bwrap; do
	[ -x "$package/$executable" ] || complete=false
done
if [ "$complete" = false ]; then
	mkdir -p "$root"
	stage=$(mktemp -d "$root/.install.XXXXXX")
	trap 'rm -rf "$stage"' EXIT
	trap 'exit 1' HUP INT TERM
	echo "Downloading Codex $version..."
	curl --fail --location --retry 3 --connect-timeout 30 --max-time 1800 \
		"$url" -o "$stage/codex.tar.gz"
	printf '%s  %s\n' "$sha256" "$stage/codex.tar.gz" | sha256sum -c -
	# Avoid the tar/gzip subprocess pipe on older VirtualShell builds.
	echo 'Extracting Codex...'
	gzip -dc "$stage/codex.tar.gz" > "$stage/codex.tar"
	rm "$stage/codex.tar.gz"
	mkdir "$stage/$version"
	tar --touch --no-same-owner -xf "$stage/codex.tar" -C "$stage/$version"
	rm "$stage/codex.tar"
	[ -f "$stage/$version/codex-package.json" ]
	for executable in bin/codex bin/codex-code-mode-host bin/codex-exec-server codex-path/rg codex-resources/bwrap; do
		chmod 755 "$stage/$version/$executable"
	done
	"$stage/$version/bin/codex" --version >/dev/null
	rm -rf "${root:?}/$version"
	mv "$stage/$version" "$root/$version"
fi
# Remove binaries from earlier package versions.
for old in "$root"/*; do
	[ "$old" = "$root/$version" ] || rm -rf "$old"
done
echo "Codex $version is ready: run codex."
