# Maintainer: Marcos Romero Lamas <marromlam@gmail.com>
pkgname=tinytex
pkgver=2026.10
pkgrel=0
pkgdesc="TinyTeX ARM64 installer with a private glibc runtime"
url="https://yihui.org/tinytex/"
arch="aarch64"
license="MIT"
depends="ca-certificates curl perl xz tar binutils patchelf fontconfig"
options="!check"
install="$pkgname.post-install $pkgname.post-upgrade"
source="tinytex-install tinytex-command downloads.txt LICENSE"

package() {
	install -Dm755 "$srcdir/tinytex-install" "$pkgdir/usr/sbin/tinytex-install"
	install -Dm755 "$srcdir/tinytex-command" "$pkgdir/usr/libexec/tinytex-command"
	install -Dm644 "$srcdir/downloads.txt" "$pkgdir/usr/share/tinytex/downloads.txt"
	install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/tinytex/LICENSE"
	mkdir -p "$pkgdir/usr/bin"
	for cmd in pdflatex xelatex lualatex latex latexmk bibtex kpsewhich tex pdftex xetex luatex luahbtex fmtutil fmtutil-sys updmap updmap-sys mktexlsr texhash makeindex tlmgr; do
		ln -s ../libexec/tinytex-command "$pkgdir/usr/bin/$cmd"
	done
}

