# Maintainer: Marcos Romero Lamas <marromlam@gmail.com>
pkgname=claude-code
pkgver=2.1.311
pkgrel=0
pkgdesc="Claude Code installer (downloads the upstream aarch64 musl binary)"
url="https://github.com/anthropics/claude-code"
arch="aarch64"
license="MIT"
depends="ca-certificates curl libgcc libstdc++ ripgrep git"
options="!check"
install="$pkgname.post-install $pkgname.post-upgrade $pkgname.pre-deinstall"
source="claude-code-install claude-command LICENSE"

package() {
	install -Dm755 "$srcdir/claude-code-install" "$pkgdir/usr/sbin/claude-code-install"
	install -Dm755 "$srcdir/claude-command" "$pkgdir/usr/bin/claude"
	install -Dm644 "$srcdir/LICENSE" "$pkgdir/usr/share/licenses/claude-code/LICENSE"
}

